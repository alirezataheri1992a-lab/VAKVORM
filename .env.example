# --- Email delivery (Resend) — contact form AND the guided Project Journey ---
# Until these are set, both the contact form and /start-uw-project validate and gracefully
# show the direct email/phone instead of pretending a message was sent. When set, the
# Project Journey emails a structured intake to INQUIRY_TO with the uploaded files as
# attachments (limits: 8 files, 10 MB each, 25 MB total — see docs/project-journey.md),
# and sends the visitor a confirmation. Attachment delivery via email is the initial
# architecture; for larger/enterprise volumes, add a storage provider (also documented).
RESEND_API_KEY=
INQUIRY_FROM="VAKVORM <website@vakvorm.nl>"   # must be a verified sender/domain in Resend
INQUIRY_TO=alireza_taheri92@hotmail.com        # where inquiries are delivered (temporary)

# --- Sanity CMS ---
# When NEXT_PUBLIC_SANITY_PROJECT_ID is empty, the site runs on local seed data and still
# builds. Set these (after provisioning the Studio in /sanity) to serve content from Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Optional: instant publishing (Sanity webhook) ---
# Leave empty to rely on time-based revalidation (published content appears within ~60s).
# Set a random secret and configure a Sanity webhook (POST to /api/revalidate with header
# x-revalidate-secret) to make published changes appear immediately.
SANITY_REVALIDATE_SECRET=
