# --- Contact form email delivery (Resend) ---
# Until these are set, the contact form validates and gracefully shows the direct
# email/phone instead of pretending a message was sent.
RESEND_API_KEY=
INQUIRY_FROM="VAKVORM <website@vakvorm.nl>"   # must be a verified sender/domain in Resend
INQUIRY_TO=alireza_taheri92@hotmail.com        # where inquiries are delivered (temporary)

# --- Sanity CMS ---
# When NEXT_PUBLIC_SANITY_PROJECT_ID is empty, the site runs on local seed data and still
# builds. Set these (after provisioning the Studio in /sanity) to serve content from Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Optional: instant publishing (Sanity webhook) ---
# Leave empty to rely on time-based revalidation (published content appears within ~60s).
# Set a random secret and configure a Sanity webhook (POST to /api/revalidate with header
# x-revalidate-secret) to make published changes appear immediately.
SANITY_REVALIDATE_SECRET=
